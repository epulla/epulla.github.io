<script is:inline src="https://unpkg.com/@popperjs/core@2"></script>
<script is:inline src="https://unpkg.com/tippy.js@6"></script>
<script is:inline define:vars={{ copied }}>
  tippy("[data-tippy-content]:not(#copy-email-btn)", {
    placement: "bottom",
    theme: "light",
  });

  const copyEmailBtnTippy = tippy("#copy-email-btn", {
    placement: "bottom",
    theme: "light",
    hideOnClick: false,
  })[0];

  const isEs = () => document.documentElement.lang === "es";
  const tipText = (el) =>
    (isEs() && el.dataset.tippyEs) || el.dataset.tippyContent;
  const localizeTips = () =>
    document
      .querySelectorAll("[data-tippy-es]")
      .forEach((el) => el._tippy?.setContent(tipText(el)));
  localizeTips();
  document.addEventListener("langchange", localizeTips);

  const copyEmailBtn = document.getElementById("copy-email-btn");
  copyEmailBtn.addEventListener("click", () => {
    const mailElement = document.getElementById("mail");
    if (navigator.clipboard) {
      navigator.clipboard.writeText(mailElement.textContent.trim());
      copyEmailBtnTippy.setContent(isEs() ? copied.es : copied.en);

      setTimeout(() => {
        copyEmailBtnTippy.setContent(tipText(copyEmailBtn));
      }, 4000);
    } else {
      window.getSelection().selectAllChildren(mailElement);
    }
  });
</script>

<style is:global>
  .dark .tippy-box[data-theme~="light"] {
    background-color: #fff;
    color: #111827;
