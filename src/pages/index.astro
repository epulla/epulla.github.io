---
import {
  Chip,
  Paragraph,
  SectionTitle,
  Title,
} from "@/features/ui/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  AppleIcon,
  AstroIcon,
  ChromeIcon,
  ClaudeIcon,
  CopyIcon,
  DaisyUiIcon,
  DjangoIcon,
  DocumentIcon,
  DrizzleIcon,
  ExternalLinkIcon,
  ExpressIcon,
  FastApiIcon,
  FirebaseIcon,
  FlutterIcon,
  GithubActionsIcon,
  GithubIcon,
  GoIcon,
  HuggingFaceIcon,
  LinkedinIcon,
  NextIcon,
  OpenCodeIcon,
  P5Icon,
  PrismaIcon,
  PythonIcon,
  ReactIcon,
  RedisIcon,
  SqliteIcon,
  SupabaseIcon,
  SvelteIcon,
  SwiftIcon,
  TailwindIcon,
  TwilioIcon,
  TypescriptIcon,
  VercelIcon,
  ViteIcon,
  VitestIcon,
  WailsIcon,
  XIcon,
} from "@/features/icons/components";
import {
  TimeLine,
  TimeLineItalic,
  TimeLineItem,
  TimeLineTime,
  TimeLineTitle,
} from "@/features/timeline/components";
import { StackIcons, type StackItem } from "@/features/card/components";
import { Image } from "astro:assets";
import patioImg from "@/assets/projects/patio.png";
import sendaImg from "@/assets/projects/senda.png";
import tabjuryImg from "@/assets/projects/tabjury.png";
import chismesilloImg from "@/assets/projects/chismesillo.png";
import snipzyImg from "@/assets/projects/snipzy.png";
import { T } from "@/features/i18n/components";
import { ui, type UiKey } from "@/features/i18n/ui";

const socials = [
  { href: "https://www.linkedin.com/in/erickpulla/", tip: "LinkedIn", label: "social.linkedin", Icon: LinkedinIcon },
  { href: "https://github.com/epulla", tip: "GitHub", label: "social.github", Icon: GithubIcon },
  { href: "https://x.com/erick_pulla", tip: "X", label: "social.x", Icon: XIcon },
  { href: "/docs/FullStack_CV_english_ErickPulla.pdf", tip: "CV", label: "social.cv", Icon: DocumentIcon },
] as const;

const ts: StackItem = { label: "Typescript", Icon: TypescriptIcon };
const chromeExt: StackItem = { tip: "tip.chromeExtension", Icon: ChromeIcon };

const featured = [
  {
    title: "Patio",
    url: "https://github.com/epulla/patio",
    desc: "proj.patio",
    image: patioImg,
    stack: [
      { label: "Go", Icon: GoIcon },
      { label: "Wails", Icon: WailsIcon },
      { label: "React", Icon: ReactIcon },
      { label: "SQLite", Icon: SqliteIcon },
    ],
  },
  {
    title: "Senda",
    url: "https://github.com/epulla/senda",
    desc: "proj.senda",
    image: sendaImg,
    stack: [ts, chromeExt],
  },
  {
    title: "TabJury",
    url: "https://chromewebstore.google.com/detail/tabjury/mbpkdfnnnncfbbdhadhofjdikngjlehk",
    desc: "proj.tabjury",
    image: tabjuryImg,
    stack: [ts, chromeExt],
  },
  {
    title: "Chismesillo",
    url: "https://chismesillo-app.vercel.app",
    desc: "proj.chismesillo",
    image: chismesilloImg,
    stack: [
      { label: "Astro", Icon: AstroIcon },
      ts,
      { label: "Tailwind CSS", Icon: TailwindIcon },
      { label: "DaisyUI", Icon: DaisyUiIcon },
      { label: "Hugging Face (transformers.js)", Icon: HuggingFaceIcon },
    ],
  },
  {
    title: "Snipzy",
    url: "https://github.com/epulla/snipzy",
    desc: "proj.snipzy",
    image: snipzyImg,
    contain: true,
    stack: [
      { label: "Swift", Icon: SwiftIcon },
      { label: "macOS (AppKit + Vision)", Icon: AppleIcon },
    ],
  },
] satisfies { title: string; url: string; desc: UiKey; image: ImageMetadata; contain?: boolean; stack: StackItem[] }[];

const more: { title?: string; titleKey?: UiKey; url?: string; desc: UiKey; stack: StackItem[] }[] = [
  {
    title: "Ziran",
    url: "https://github.com/epulla/ziran",
    desc: "proj.ziran",
    stack: [
      { label: "Swift", Icon: SwiftIcon },
      { label: "macOS", Icon: AppleIcon },
    ],
  },
  {
    title: "OpenCode Anthropic Auth",
    url: "https://github.com/epulla/opencode-anthropic-login-via-cli",
    desc: "proj.anthropicAuth",
    stack: [
      { label: "OpenCode", Icon: OpenCodeIcon },
      { label: "Claude", Icon: ClaudeIcon },
      ts,
    ],
  },
  {
    title: "i-am-burned-out",
    url: "https://github.com/epulla/i-am-burned-out",
    desc: "proj.burnedOut",
    stack: [
      { label: "Claude Code", Icon: ClaudeIcon },
      { label: "OpenCode", Icon: OpenCodeIcon },
      ts,
    ],
  },
  {
    title: "Prod Tickets",
    desc: "proj.prodTickets",
    stack: [{ label: "Svelte", Icon: SvelteIcon }, ts],
  },
  {
    titleKey: "proj.portfolio.title",
    url: "https://epulla.github.io/",
    desc: "proj.portfolio",
    stack: [
      { label: "Astro", Icon: AstroIcon },
      { label: "React", Icon: ReactIcon },
    ],
  },
  {
    title: "Easy Web Macros",
    url: "https://github.com/epulla/easy-web-macros",
    desc: "proj.easyWebMacros",
    stack: [
      { label: "Svelte", Icon: SvelteIcon },
      { label: "Vite", Icon: ViteIcon },
      { label: "Chrome API", Icon: ChromeIcon },
    ],
  },
  {
    title: "Moodle API Handler",
    url: "https://github.com/epulla/moodle-api-handler",
    desc: "proj.moodle",
    stack: [
      { label: "Svelte", Icon: SvelteIcon },
      { label: "Firebase", Icon: FirebaseIcon },
    ],
  },
  {
    title: "Quicknote",
    url: "https://github.com/epulla/quicknote",
    desc: "proj.quicknote",
    stack: [
      { label: "React", Icon: ReactIcon },
      { label: "FastAPI", Icon: FastApiIcon },
      { label: "Redis", Icon: RedisIcon },
    ],
  },
  {
    title: "Twilio Video Call App",
    url: "https://github.com/epulla/twilio_minimal_video_call_app",
    desc: "proj.twilio",
    stack: [
      { label: "FastAPI", Icon: FastApiIcon },
      { label: "Twilio", Icon: TwilioIcon },
    ],
  },
  {
    title: "Mobile Pokedex App",
    url: "https://github.com/epulla/pokedex-flutter",
    desc: "proj.pokedex",
    stack: [{ label: "Flutter", Icon: FlutterIcon }],
  },
  {
    title: "Bingo Generator",
    url: "https://github.com/epulla/BingoGenerator",
    desc: "proj.bingo",
    stack: [{ label: "Python", Icon: PythonIcon }],
  },
];

const stack: {
  group: UiKey;
  items: { name: string; tip?: UiKey; Icon: typeof ReactIcon }[];
}[] = [
  {
    group: "stack.frontend",
    items: [
      { name: "React", tip: "tip.react", Icon: ReactIcon },
      { name: "Next.js", Icon: NextIcon },
      { name: "Svelte", tip: "tip.svelte", Icon: SvelteIcon },
      { name: "Astro", tip: "tip.astro", Icon: AstroIcon },
      { name: "Tailwind CSS", tip: "tip.tailwind", Icon: TailwindIcon },
      { name: "DaisyUI", tip: "tip.daisyui", Icon: DaisyUiIcon },
      { name: "p5.js", tip: "tip.p5", Icon: P5Icon },
    ],
  },
  {
    group: "stack.backend",
    items: [
      { name: "Python", tip: "tip.python", Icon: PythonIcon },
      { name: "FastAPI", Icon: FastApiIcon },
      { name: "Django", Icon: DjangoIcon },
      { name: "Express", Icon: ExpressIcon },
      { name: "Firebase", tip: "tip.firebase", Icon: FirebaseIcon },
      { name: "Supabase", tip: "tip.supabase", Icon: SupabaseIcon },
      { name: "Drizzle", tip: "tip.drizzle", Icon: DrizzleIcon },
      { name: "Prisma", Icon: PrismaIcon },
    ],
  },
  {
    group: "stack.tools",
    items: [
      { name: "Claude Code", tip: "tip.claude", Icon: ClaudeIcon },
      { name: "OpenCode", Icon: OpenCodeIcon },
      { name: "Hugging Face", tip: "tip.huggingFace", Icon: HuggingFaceIcon },
      { name: "Swift", tip: "tip.swift", Icon: SwiftIcon },
      { name: "Vercel", Icon: VercelIcon },
      { name: "Vitest", Icon: VitestIcon },
      { name: "GitHub Actions", Icon: GithubActionsIcon },
    ],
  },
];
---

<BaseLayout titleKey="meta.title">
  <section id="intro" class="flex gap-4 items-center">
    <img
      class="w-[115px] sm:w-[150px] md:w-[200px] rounded-xl border border-razzmatazz-400 dark:border-razzmatazz-700 hover:translate-x-1 transition"
      src="/images/profile_photo.png"
      alt="Erick Pulla"
    />
    <div class="flex flex-col gap-2 min-w-0">
      <Title>Erick Pulla</Title>
      <Paragraph><T k="intro.hello" /></Paragraph>
      <div
        class="flex items-center gap-2 rounded bg-slate-100 dark:bg-gray-900 py-1 px-2"
      >
        <a
          id="mail"
          href="mailto:erickpulladsi@gmail.com"
          class="flex-1 min-w-0 truncate font-mono text-gray-500 dark:text-gray-400 hover:text-razzmatazz-600 dark:hover:text-razzmatazz-400 text-xs sm:text-base rounded focus-visible:outline-2 focus-visible:outline-razzmatazz-500 transition"
          >erickpulladsi@gmail.com</a
        >
        <button
          id="copy-email-btn"
          type="button"
          data-tip={ui.en["tip.copy"]}
          data-tip-es={ui.es["tip.copy"]}
          data-copied={ui.en["tip.copied"]}
          data-copied-es={ui.es["tip.copied"]}
          class="rounded text-gray-500 dark:text-gray-400 hover:text-razzmatazz-600 dark:hover:text-razzmatazz-400 focus-visible:outline-2 focus-visible:outline-razzmatazz-500 transition cursor-pointer"
          ><span class="sr-only"><T k="tip.copy" /></span><CopyIcon /></button
        >
      </div>
      <div class="flex gap-1 -ml-2">
        {
          socials.map(({ href, tip, label, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              data-tip={tip}
              class="flex items-center justify-center size-9 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-200/70 dark:hover:bg-gray-700/70 hover:text-razzmatazz-600 dark:hover:text-razzmatazz-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-razzmatazz-500 transition [&_svg]:size-5"
            >
              <span class="sr-only"><T k={label} /></span>
              <Icon />
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section id="experience" class="flex flex-col gap-3">
    <SectionTitle><T k="section.experience" /></SectionTitle>
    <TimeLine>
      <TimeLineItem>
        <TimeLineTime><T k="exp.ube.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.ube.title" /><TimeLineItalic>
            Durán, Guayas, Ecuador
          </TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.ube.1" /></Paragraph>
          </li>
        </ul>
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="exp.novacomp.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.novacomp.title" /><TimeLineItalic>
            San José, Costa Rica
          </TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.novacomp.1" /></Paragraph>
          </li>
          <li>
            <Paragraph><T k="exp.novacomp.2" /></Paragraph>
          </li>
          <li>
            <Paragraph><T k="exp.novacomp.3" /></Paragraph>
          </li>
        </ul>
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="exp.ioet.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.ioet.title" /><TimeLineItalic>
            <T k="loc.usa" />
          </TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.ioet.1" /></Paragraph>
          </li>
          <li>
            <Paragraph><T k="exp.ioet.2" /></Paragraph>
          </li>
        </ul>
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="exp.gye.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.gye.title" />
          <TimeLineItalic>Guayaquil, Guayas, Ecuador</TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.gye.1" /></Paragraph>
          </li>
          <li>
            <Paragraph><T k="exp.gye.2" /></Paragraph>
          </li>
        </ul>
        <br />
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="exp.priscila.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.priscila.title" />
          <TimeLineItalic>Guayaquil, Guayas, Ecuador</TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.priscila.1" /></Paragraph>
          </li>
          <li>
            <Paragraph><T k="exp.priscila.2" /></Paragraph>
          </li>
        </ul>
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="exp.casagrande.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="exp.casagrande.title" />
          <TimeLineItalic>Guayaquil, Guayas, Ecuador</TimeLineItalic>
        </TimeLineTitle>
        <ul class="list-disc ml-4">
          <li>
            <Paragraph><T k="exp.casagrande.1" /></Paragraph>
          </li>
        </ul>
      </TimeLineItem>
    </TimeLine>
  </section>

  <section id="projects" class="flex flex-col gap-3">
    <SectionTitle><T k="section.projects" /></SectionTitle>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        featured.map(({ title, url, desc, stack, image, contain }, i) => (
          <article
            class:list={[
              "group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow hover:border-razzmatazz-400 dark:border-gray-700 dark:bg-gray-800 dark:hover:border-razzmatazz-500 transition",
              { "sm:col-span-2": i === 0 },
            ]}
          >
            <div class="aspect-[16/10] overflow-hidden border-b border-gray-200 bg-slate-100 dark:border-gray-700 dark:bg-gray-900">
              <Image
                src={image}
                alt=""
                widths={[480, 800, 1200]}
                sizes={i === 0 ? "(min-width: 768px) 720px, 100vw" : "(min-width: 768px) 360px, (min-width: 640px) 50vw, 100vw"}
                class:list={[
                  "size-full group-hover:scale-[1.02] transition duration-300",
                  contain ? "object-contain p-6" : "object-cover object-top",
                ]}
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
              <h3 class="flex items-center justify-between gap-2 text-xl font-bold text-gray-900 dark:text-white">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-razzmatazz-500"
                >
                  {title}
                </a>
                <span class="text-gray-400 group-hover:text-razzmatazz-500 transition [&_svg]:size-5">
                  <ExternalLinkIcon />
                </span>
              </h3>
              <p class="text-gray-700 dark:text-gray-400 [&_a]:relative [&_a]:z-10">
                <T k={desc} />
              </p>
              <div class="mt-auto pt-2">
                <StackIcons stack={stack} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <h3 class="mt-4 font-mono font-bold text-gray-700 dark:text-gray-300">
      <T k="section.moreProjects" />
    </h3>
    <ul class="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white shadow dark:divide-gray-700 dark:border-gray-700 dark:bg-gray-800">
      {
        more.map(({ title, titleKey, url, desc, stack }) => (
          <li class="relative flex flex-col gap-1 p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
              <h4 class="font-semibold text-gray-900 dark:text-white">
                {url ? (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded hover:text-razzmatazz-600 dark:hover:text-razzmatazz-400 after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-razzmatazz-500"
                  >
                    {titleKey ? <T k={titleKey} /> : title}
                  </a>
                ) : titleKey ? (
                  <T k={titleKey} />
                ) : (
                  title
                )}
              </h4>
              <StackIcons stack={stack} />
            </div>
            <p class="text-sm text-gray-700 dark:text-gray-400 [&_a]:relative [&_a]:z-10">
              <T k={desc} />
            </p>
          </li>
        ))
      }
    </ul>
  </section>
  <section id="techs" class="flex flex-col gap-3">
    <SectionTitle><T k="section.techs" /></SectionTitle>
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-2">
          <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">
            <T k={group} />
          </h3>
          <ul class="flex flex-wrap gap-2">
            {items.map(({ name, tip, Icon }) => (
              <Chip tip={tip}>
                <Icon size={20} />
                {name}
              </Chip>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
  <section id="education" class="flex flex-col gap-3">
    <SectionTitle><T k="section.education" /></SectionTitle>
    <TimeLine>
      <TimeLineItem>
        <TimeLineTime><T k="edu.master.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="edu.master.title" /><TimeLineItalic>
            Guayaquil, Guayas, Ecuador
          </TimeLineItalic>
        </TimeLineTitle>
        <Paragraph><T k="edu.master.desc" /></Paragraph>
      </TimeLineItem>
      <TimeLineItem>
        <TimeLineTime><T k="edu.eng.time" /></TimeLineTime>
        <TimeLineTitle>
          <T k="edu.eng.title" /><TimeLineItalic>
            Guayaquil, Guayas, Ecuador
          </TimeLineItalic>
        </TimeLineTitle>
        <Paragraph><T k="edu.eng.desc" /></Paragraph>
      </TimeLineItem>
    </TimeLine>
  </section>
</BaseLayout>

<script>
  const copyEmailBtn = document.getElementById("copy-email-btn")!;
  copyEmailBtn.addEventListener("click", () => {
    const mailElement = document.getElementById("mail")!;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(mailElement.textContent!.trim());
      const { copied, copiedEs } = copyEmailBtn.dataset;
      window.showTip(
        copyEmailBtn,
        (document.documentElement.lang === "es" && copiedEs) || copied!,
      );
    } else {
      window.getSelection()?.selectAllChildren(mailElement);
    }
  });
</script>
