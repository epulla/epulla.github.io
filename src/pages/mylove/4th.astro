---
// Feliz 4to Mesesaurio mi amor 🦕💛
// Parallax scrollytelling día→noche con dinosaurios. Un solo archivo.
// Arte de dinosaurios de fondo: OpenMoji (CC BY-SA 4.0) — https://openmoji.org
// Stegosaurus protagonista dibujado a mano en el mismo estilo.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feliz 4to Mesesaurio 🦕💛</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Fredoka:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- GSAP + ScrollTrigger (CDN, embebido) -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"
    ></script>

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: auto;
      }

      body {
        font-family: "Fredoka", sans-serif;
        background: #0d1030;
        color: #fff;
        overflow-x: hidden;
      }

      /* ── Scroll track ── */
      #scroll-track {
        position: relative;
        height: 850vh;
      }
      #stage {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        overflow: hidden;
      }

      /* ── Cielo ── */
      #sky {
        position: absolute;
        inset: 0;
        will-change: background;
      }

      /* nubes */
      .cloud {
        position: absolute;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        filter: blur(1px);
        box-shadow:
          40px 8px 0 -4px rgba(255, 255, 255, 0.9),
          -38px 10px 0 -6px rgba(255, 255, 255, 0.9),
          14px -14px 0 -4px rgba(255, 255, 255, 0.85);
        will-change: transform, opacity;
        pointer-events: none;
      }

      /* ── Estrellas ── */
      #stars {
        position: absolute;
        inset: 0;
        opacity: 0;
        will-change: opacity;
        pointer-events: none;
      }
      /* .star -> bloque global (creado por JS) */
      /* estrella fugaz */
      #shooting-star {
        position: absolute;
        top: 16%;
        left: 70%;
        width: 130px;
        height: 2px;
        background: linear-gradient(
          to left,
          rgba(255, 255, 255, 0.95),
          rgba(255, 255, 255, 0)
        );
        border-radius: 2px;
        opacity: 0;
        transform: rotate(18deg);
        pointer-events: none;
      }
      #shooting-star::after {
        content: "";
        position: absolute;
        right: -2px;
        top: -2px;
        width: 6px;
        height: 6px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 0 10px 3px rgba(255, 255, 255, 0.9);
      }

      /* ── Sol y Luna ── */
      .celestial {
        position: absolute;
        left: 50%;
        top: 0;
        border-radius: 50%;
        will-change: transform, opacity;
      }
      #sun {
        width: clamp(70px, 12vw, 140px);
        height: clamp(70px, 12vw, 140px);
        margin-left: calc(clamp(70px, 12vw, 140px) / -2);
        background: radial-gradient(circle at 40% 38%, #fff6d6, #ffd54f 55%, #ffb300);
        box-shadow:
          0 0 60px 20px rgba(255, 201, 64, 0.55),
          0 0 120px 50px rgba(255, 179, 0, 0.3);
      }
      #moon {
        width: clamp(80px, 13vw, 150px);
        height: clamp(80px, 13vw, 150px);
        margin-left: calc(clamp(80px, 13vw, 150px) / -2);
        background: radial-gradient(circle at 38% 36%, #ffffff, #e9ecff 60%, #c7cdf2);
        box-shadow:
          0 0 50px 14px rgba(220, 226, 255, 0.6),
          0 0 110px 44px rgba(180, 190, 255, 0.28);
        opacity: 0;
      }
      .crater {
        position: absolute;
        border-radius: 50%;
        background: rgba(170, 178, 220, 0.5);
      }

      /* ── Colinas ── */
      .ground {
        position: absolute;
        left: 0;
        width: 100%;
        bottom: 0;
        will-change: transform;
      }
      #hills-back {
        height: 44%;
        z-index: 0;
        background: linear-gradient(to top, #8fbf7f, #aedca0);
        clip-path: polygon(
          0 42%, 14% 30%, 28% 40%, 42% 26%, 58% 40%, 72% 26%,
          86% 38%, 100% 30%, 100% 100%, 0 100%
        );
        opacity: 0.9;
      }
      #hills-mid {
        height: 32%;
        z-index: 2;
        background: linear-gradient(to top, #6fae6a, #8ac881);
        clip-path: polygon(
          0 52%, 16% 36%, 32% 52%, 50% 34%, 66% 52%, 82% 36%,
          100% 50%, 100% 100%, 0 100%
        );
      }
      #ground-front {
        height: 17%;
        background: linear-gradient(to top, #4f8f52, #66a861);
      }

      /* matorrales / helechos lejanos: .fern-far -> bloque global (creado por JS) */
      /* helechos de primer plano (marco) */
      .fern-front {
        position: absolute;
        bottom: -6px;
        width: clamp(90px, 16vw, 200px);
        z-index: 7;
        pointer-events: none;
        will-change: transform;
      }
      .fern-front.left {
        left: -10px;
      }
      .fern-front.right {
        right: -10px;
        transform: scaleX(-1);
      }
      /* matas de pasto: .grass -> bloque global (creado por JS) */

      /* ── Dinos de fondo ── */
      .dino-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      #layer-far {
        z-index: 1;
      }
      #layer-mid {
        z-index: 3;
      }
      #layer-near {
        z-index: 5;
      }
      #grass-layer {
        z-index: 5;
      }
      /* NOTA: las reglas de .bg-dino/.inner/.star/.grass/.fern-far/.fly-heart
         viven en el bloque <style is:global> de abajo porque esos elementos
         se crean por JS y no reciben el atributo de scope de Astro. */

      /* ── Dinos protagonistas ── */
      #main-dinos {
        position: absolute;
        left: 50%;
        bottom: 7%;
        transform: translateX(-50%);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: clamp(0px, 1vw, 14px);
        z-index: 6;
        width: min(92vw, 660px);
        will-change: transform;
      }
      .main-dino {
        position: relative;
        width: clamp(140px, 27vw, 290px);
        transform-origin: bottom center;
        will-change: transform;
      }
      .main-dino .breath {
        transform-origin: bottom center;
        animation: breathe var(--br, 3.2s) ease-in-out infinite;
      }
      @keyframes breathe {
        0%,
        100% {
          transform: translateY(0) scaleY(1);
        }
        50% {
          transform: translateY(-3px) scaleY(1.015);
        }
      }
      .main-dino svg {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 6px 4px rgba(0, 0, 0, 0.28));
      }
      /* ojos para dormir (párpado) — ocultos de día */
      .sleep-lid {
        opacity: 0;
      }

      #love-heart {
        position: absolute;
        left: 50%;
        bottom: 100%;
        margin-bottom: -8px;
        transform: translate(-50%, 0) scale(0);
        font-size: clamp(30px, 5vw, 54px);
        opacity: 0;
        z-index: 7;
        will-change: transform, opacity;
        filter: drop-shadow(0 0 12px rgba(255, 120, 160, 0.7));
      }

      .zzz {
        position: absolute;
        left: 64%;
        bottom: 100%;
        margin-bottom: 6px;
        font-family: "Baloo 2", sans-serif;
        font-weight: 800;
        color: #fff;
        opacity: 0;
        z-index: 7;
        pointer-events: none;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      }

      /* ── Intro ── */
      #intro {
        position: fixed;
        inset: 0;
        z-index: 30;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding: clamp(2.5rem, 9vh, 6rem) 2rem 2rem;
        pointer-events: none;
        transition: opacity 0.6s ease;
      }
      #intro h1 {
        font-family: "Baloo 2", sans-serif;
        font-weight: 800;
        font-size: clamp(1.8rem, 6vw, 3.4rem);
        color: #5a3d2b;
        text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
        line-height: 1.1;
        margin-bottom: 0.6rem;
      }
      #intro p {
        font-size: clamp(1rem, 3vw, 1.4rem);
        color: #6b4a33;
        margin-bottom: 1.6rem;
        font-weight: 500;
      }
      .scroll-hint {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        color: #5a3d2b;
        font-weight: 600;
        font-size: clamp(0.95rem, 2.6vw, 1.2rem);
      }
      .scroll-mouse {
        width: 30px;
        height: 50px;
        border: 3px solid #5a3d2b;
        border-radius: 16px;
        position: relative;
      }
      .scroll-mouse::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 8px;
        width: 5px;
        height: 9px;
        margin-left: -2.5px;
        background: #5a3d2b;
        border-radius: 3px;
        animation: wheel 1.4s ease-in-out infinite;
      }
      @keyframes wheel {
        0% {
          transform: translateY(0);
          opacity: 1;
        }
        70% {
          transform: translateY(14px);
          opacity: 0;
        }
        100% {
          opacity: 0;
        }
      }
      .arrow {
        font-size: 1.6rem;
        animation: bounce 1.4s ease-in-out infinite;
      }
      @keyframes bounce {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(10px);
        }
      }

      /* ── Mensajes de la historia (durante el día→noche) ── */
      #story {
        position: fixed;
        left: 50%;
        top: 18%;
        transform: translateX(-50%);
        z-index: 21;
        width: min(92vw, 720px);
        text-align: center;
        pointer-events: none;
      }
      .story-msg {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        margin: 0;
        opacity: 0;
        font-family: "Baloo 2", sans-serif;
        font-weight: 800;
        font-size: clamp(1.4rem, 5vw, 2.8rem);
        line-height: 1.15;
        color: #fff;
        /* legible sobre cielo claro (día) y oscuro (noche) */
        text-shadow:
          0 2px 10px rgba(0, 0, 0, 0.45),
          0 0 18px rgba(0, 0, 0, 0.35),
          0 0 26px rgba(255, 210, 230, 0.5);
        will-change: opacity, transform;
      }

      /* ── Mensaje final ── */
      #final {
        position: fixed;
        left: 50%;
        top: 20%;
        transform: translate(-50%, -10px);
        z-index: 22;
        text-align: center;
        opacity: 0;
        pointer-events: none;
        width: min(92vw, 760px);
        padding: 0 1rem;
      }
      #final h2 {
        font-family: "Baloo 2", sans-serif;
        font-weight: 800;
        font-size: clamp(1.6rem, 6vw, 3.6rem);
        line-height: 1.12;
        color: #fff;
        text-shadow:
          0 0 18px rgba(255, 182, 193, 0.85),
          0 2px 10px rgba(0, 0, 0, 0.4);
      }
      #final .accent {
        color: #ffd6e6;
      }
      #reset-btn {
        margin-top: 1.4rem;
        font-family: "Fredoka", sans-serif;
        font-size: clamp(0.85rem, 2.4vw, 1.05rem);
        font-weight: 500;
        color: #fff;
        background: rgba(255, 255, 255, 0.12);
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        border-radius: 999px;
        padding: 0.55em 1.4em;
        cursor: pointer;
        pointer-events: auto;
        backdrop-filter: blur(6px);
        transition:
          transform 0.25s ease,
          background 0.25s ease;
      }
      #reset-btn:hover {
        transform: translateY(-2px) scale(1.04);
        background: rgba(255, 255, 255, 0.22);
      }

      /* ── Corazones voladores ── */
      #hearts {
        position: fixed;
        inset: 0;
        z-index: 20;
        pointer-events: none;
        overflow: hidden;
      }
      /* .fly-heart -> bloque global (creado por JS) */

      @media (max-width: 640px) {
        #main-dinos {
          bottom: 9%;
        }
        #final {
          top: 14%;
        }
      }
    </style>

    <!-- Estilos GLOBALES: aplican a elementos creados por JS (sin atributo
         de scope de Astro): herd, estrellas, pasto, helechos lejanos,
         corazones voladores. -->
    <style is:global>
      .bg-dino {
        position: absolute;
        will-change: transform, opacity;
      }
      .bg-dino svg {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.16));
      }
      .layer-far .bg-dino {
        opacity: 0.62;
      }
      .layer-mid .bg-dino {
        opacity: 0.85;
      }
      .layer-near .bg-dino {
        opacity: 1;
      }
      .bg-dino .inner {
        animation: dino-walkbob var(--bob, 2s) ease-in-out infinite;
        transform-origin: bottom center;
      }
      .bg-dino.flyer .inner {
        animation: dino-flap var(--bob, 3s) ease-in-out infinite;
      }
      @keyframes dino-walkbob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-4px);
        }
      }
      @keyframes dino-flap {
        0%,
        100% {
          transform: translateY(0) rotate(-2deg);
        }
        50% {
          transform: translateY(-10px) rotate(2deg);
        }
      }
      .star {
        position: absolute;
        background: #fff;
        border-radius: 50%;
        animation: dino-twinkle var(--tw, 3s) ease-in-out infinite alternate;
      }
      @keyframes dino-twinkle {
        from {
          opacity: 0.25;
        }
        to {
          opacity: 1;
        }
      }
      .grass {
        position: absolute;
        bottom: 8%;
        z-index: 4;
        opacity: 0.9;
        pointer-events: none;
      }
      .fern-far {
        position: absolute;
        bottom: 30%;
        width: 34px;
        height: 30px;
        opacity: 0.45;
        will-change: transform;
        pointer-events: none;
      }
      .fly-heart {
        position: absolute;
        top: 0;
        left: 0;
        font-size: var(--hs, 24px);
        will-change: transform, opacity;
        opacity: 0;
      }
      @media (max-width: 640px) {
        .layer-far .bg-dino:nth-child(2n) {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <div id="scroll-track">
      <div id="stage">
        <div id="sky"></div>

        <div id="stars"></div>
        <div id="shooting-star"></div>

        <!-- sol y luna -->
        <div id="sun" class="celestial"></div>
        <div id="moon" class="celestial">
          <span class="crater" style="width:18%;height:18%;left:24%;top:28%"></span>
          <span class="crater" style="width:12%;height:12%;left:58%;top:22%"></span>
          <span class="crater" style="width:22%;height:22%;left:52%;top:54%"></span>
          <span class="crater" style="width:10%;height:10%;left:30%;top:62%"></span>
        </div>

        <!-- nubes -->
        <div class="cloud" data-depth="0.3" style="width:60px;height:30px;left:12%;top:18%"></div>
        <div class="cloud" data-depth="0.5" style="width:80px;height:40px;left:62%;top:12%"></div>
        <div class="cloud" data-depth="0.4" style="width:50px;height:26px;left:80%;top:30%"></div>
        <div class="cloud" data-depth="0.6" style="width:70px;height:34px;left:34%;top:8%"></div>

        <!-- colinas -->
        <div id="hills-back" class="ground"></div>
        <div id="hills-mid" class="ground"></div>

        <!-- capas de dinos (se rellenan por JS) -->
        <div class="dino-layer layer-far" id="layer-far"></div>
        <div class="dino-layer layer-mid" id="layer-mid"></div>

        <!-- suelo frontal -->
        <div id="ground-front" class="ground" style="z-index:4"></div>

        <!-- capa cercana de dinos (encima del suelo frontal) -->
        <div class="dino-layer layer-near" id="layer-near"></div>

        <!-- pasto -->
        <div class="dino-layer" id="grass-layer"></div>

        <!-- helechos de primer plano -->
        <div class="fern-front left" id="fern-left"></div>
        <div class="fern-front right" id="fern-right"></div>

        <!-- dinos protagonistas -->
        <div id="main-dinos">
          <div class="main-dino" id="stego"></div>
          <div class="main-dino" id="bronto"></div>
          <div id="love-heart">💛</div>
          <div class="zzz" id="zzz1">z</div>
          <div class="zzz" id="zzz2">Z</div>
          <div class="zzz" id="zzz3">z</div>
        </div>
      </div>
    </div>

    <!-- corazones finales -->
    <div id="hearts"></div>

    <!-- mensajes de la historia (aparecen durante la transición día→noche) -->
    <div id="story">
      <p class="story-msg" data-i="0">Hola mi amor</p>
      <p class="story-msg" data-i="1">Hemos estado separados un tiempito</p>
      <p class="story-msg" data-i="2">Sin poder vernos mucho</p>
      <p class="story-msg" data-i="3">
        Pero quiero que sepas que siempre pienso en ti
      </p>
    </div>

    <!-- mensaje final -->
    <div id="final">
      <h2>Feliz <span class="accent">4to Mesesaurio</span><br />mi amor 🦕💛</h2>
      <button id="reset-btn" type="button">↺ Reinicia la animación</button>
    </div>

    <!-- intro -->
    <div id="intro">
      <h1>Feliz 4to Mesesaurio 🦕💛</h1>
      <p>Una pequeña historia prehistórica para ti…</p>
      <div class="scroll-hint">
        <div class="scroll-mouse"></div>
        <span>Desliza hacia abajo</span>
        <span class="arrow">⬇️</span>
      </div>
    </div>

    <script is:raw>
      // ════════════════════════════════════════════════════════════
      //  ARTE DE DINOSAURIOS
      //  Fondo: OpenMoji (CC BY-SA 4.0). viewBox 0 0 72 72.
      //  Protagonista Stegosaurus: dibujado a mano (mismo estilo).
      // ════════════════════════════════════════════════════════════
