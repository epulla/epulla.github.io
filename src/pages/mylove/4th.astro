        let m = markup;
        // colores de relleno comunes en OpenMoji
        const greens = ["#B1CC33", "#5C9E31"];
        const browns = ["#A57939", "#a57939", "#6a462f"];
        greens.forEach((g, i) => {
          m = m.split(g).join(i === 1 && fill2 ? fill2 : fill);
        });
        browns.forEach((b, i) => {
          m = m.split(b).join(i === 2 && fill2 ? fill2 : fill);
        });
        return m;
      }

      function svgWrap(inner) {
        return (
          `<svg viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">` +
          inner +
          `</svg>`
        );
      }

      // ── Stegosaurus protagonista (dibujado a mano, estilo OpenMoji) ──
      function stegoSVG() {
        return svgWrap(`
          <g id="color">
            <path fill="#8fd6b4" d="M14 46 C12 38 16 33 24 32 C30 31 40 31 48 33 C56 35 60 39 59 45 C58 50 52 52 44 52 L20 52 C16 52 14.5 49 14 46 Z"/>
            <path fill="#8fd6b4" d="M59 41 c4-1 8 0 9 4 c1 4-2 7-6 7 c-3 0-6-2-6-5 c0-3 1-5 3-6 Z"/>
            <path fill="#8fd6b4" d="M14 44 c-5 1-9 4-11 8 c3 0 6-1 8-2 c2-1 4-3 5-4 Z"/>
            <ellipse fill="#b6e8cf" cx="34" cy="46" rx="16" ry="5"/>
            <path fill="#ffc8a0" d="M21 33 c-1-7 3-11 6-12 c1 6-1 10-3 13 Z"/>
            <path fill="#ffb38a" d="M31 31 c-1-8 3-13 6-14 c1 7-1 12-3 15 Z"/>
            <path fill="#ffc8a0" d="M41 31 c0-8 4-12 7-13 c1 7-2 11-4 14 Z"/>
            <path fill="#ffb38a" d="M51 33 c1-6 4-9 7-9 c0 5-2 9-4 11 Z"/>
          </g>
          <g id="line">
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 46 C12 38 16 33 24 32 C30 31 40 31 48 33 C56 35 60 39 59 45 C58 50 52 52 44 52 L20 52 C16 52 14.5 49 14 46 Z"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M59 41 c4-1 8 0 9 4 c1 4-2 7-6 7 c-3 0-6-2-6-5 c0-3 1-5 3-6 Z"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 44 c-5 1-9 4-11 8 c3 0 6-1 8-2 c2-1 4-3 5-4"/>
            <path fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round" d="M21 33 c-1-7 3-11 6-12 c1 6-1 10-3 13"/>
            <path fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round" d="M31 31 c-1-8 3-13 6-14 c1 7-1 12-3 15"/>
            <path fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round" d="M41 31 c0-8 4-12 7-13 c1 7-2 11-4 14"/>
            <path fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round" d="M51 33 c1-6 4-9 7-9 c0 5-2 9-4 11"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" d="M22 52 v8"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" d="M30 52 v9"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" d="M42 52 v9"/>
            <path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" d="M50 52 v8"/>
            <circle class="eye-open eye-stego" cx="63" cy="44" r="1.7" fill="#000"/>
            <path class="sleep-lid lid-stego" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" d="M60.5 44 q2.5 2 5 0"/>
            <circle cx="62" cy="48" r="2.2" fill="#ff9bb3" opacity="0.6"/>
            <path fill="none" stroke="#000" stroke-width="1.4" stroke-linecap="round" d="M64 48 q2 1 3-1"/>
          </g>
        `);
      }

      // Inyecta protagonistas, con grupo .breath para respiración suave.
      function heroSVG(inner) {
        // Envuelve el contenido del svg en un <g class="breath">
        const i = inner.indexOf(">");
        const open = inner.slice(0, i + 1);
        const rest = inner.slice(i + 1, inner.lastIndexOf("</svg>"));
        return open + `<g class="breath">` + rest + `</g></svg>`;
      }

      // Bronto = sauropod OpenMoji recoloreado morado pastel + ojo/cachete
      function brontoSVG() {
        const recolored = recolor(DINO.sauropod, "#b39ddb");
        // añadir ojo, cachete y párpado de sueño cerca de la cabeza (~x60,y15)
        const extras =
          `<circle class="eye-open eye-bronto" cx="60.5" cy="14.5" r="1.7" fill="#000"/>` +
          `<path class="sleep-lid lid-bronto" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" d="M58.5 14.5 q2 1.6 4 0"/>` +
          `<circle cx="58.5" cy="18" r="2" fill="#ff9bb3" opacity="0.55"/>`;
        return svgWrap(recolored + extras);
      }

      document.getElementById("stego").innerHTML = heroSVG(stegoSVG());
      document.getElementById("bronto").innerHTML = heroSVG(brontoSVG());

      // ── Helechos (SVG simple) ──
      function fernSVG(color) {
        return (
          `<svg viewBox="0 0 100 110" xmlns="http://www.w3.org/2000/svg">` +
          `<g fill="${color}">` +
          `<path d="M50 110 C50 70 30 50 18 40 C34 48 46 60 50 78 C50 50 60 30 78 18 C64 34 54 52 52 76 C58 58 74 48 92 46 C72 54 56 70 50 110 Z"/>` +
          `<path d="M50 110 C48 80 40 64 28 54 C42 60 50 72 52 88 Z"/>` +
          `</g></svg>`
        );
      }
      document.getElementById("fern-left").innerHTML = fernSVG("#2f6b3a");
      document.getElementById("fern-right").innerHTML = fernSVG("#2f6b3a");

      // matas de pasto
      function grassSVG(color) {
        return (
          `<svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" width="60" height="30">` +
          `<g fill="${color}">` +
          `<path d="M30 30 C28 18 24 10 20 4 C26 10 30 18 30 30 Z"/>` +
          `<path d="M30 30 C32 16 38 8 46 2 C38 12 34 20 34 30 Z"/>` +
          `<path d="M28 30 C24 20 16 14 8 10 C18 16 24 22 26 30 Z"/>` +
          `</g></svg>`
        );
      }

      // ════════════════════════════════════════════════════════════
      //  HERD: generar dinos de fondo (3 capas)
      // ════════════════════════════════════════════════════════════
      // paleta pastel para recolorear dinos de fondo
      const PASTELS = [
        "#9ec1f0", "#f6a5a5", "#f7c873", "#a9e0c5", "#c5a3e0",
        "#f4a9cf", "#8fd6b4", "#ffc8a0", "#b39ddb",
      ];
      const GROUND_SPECIES = ["trex", "mammoth", "lizard", "croc", "sauropod"];

      let dinoSeq = 0;
      function makeDino(species, color, size, flip, bob) {
        const wrap = document.createElement("div");
        wrap.className = "bg-dino";
        if (species === "dragon") wrap.classList.add("flyer");
        wrap.style.width = size + "px";
        wrap.style.setProperty("--bob", bob + "s");
        const inner = document.createElement("div");
        inner.className = "inner";
        if (flip) inner.style.transform = "scaleX(-1)";
        let mk = recolor(DINO[species], color);
        inner.innerHTML = svgWrap(mk);
        wrap.appendChild(inner);
        wrap.dataset.id = "d" + dinoSeq++;
        return wrap;
      }

      function rand(a, b) {
        return a + Math.random() * (b - a);
      }
      function pick(arr) {
        return arr[(Math.random() * arr.length) | 0];
      }

      const exitDinos = []; // para animar la salida nocturna

      function populateLayer(layerId, opts) {
        const layer = document.getElementById(layerId);
        for (let i = 0; i < opts.count; i++) {
          const isFlyer = opts.flyers && Math.random() < opts.flyerChance;
          const species = isFlyer ? "dragon" : pick(GROUND_SPECIES);
          const size = rand(opts.minSize, opts.maxSize);
          const flip = Math.random() < 0.5;
          const bob = rand(1.6, 2.8);
          const color = pick(PASTELS);
          const d = makeDino(species, color, size, flip, bob);
          // posición horizontal repartida en todo el ancho
          const leftPct = (i / opts.count) * 100 + rand(-5, 5);
          d.style.left = leftPct + "%";
          if (isFlyer) {
            d.style.top = rand(opts.skyTop[0], opts.skyTop[1]) + "%";
          } else {
            d.style.bottom = rand(opts.botMin, opts.botMax) + "%";
          }
          // dirección de salida nocturna: hacia el borde más cercano
          d._exitLeft = leftPct < 50;
          d._flyer = isFlyer;
          layer.appendChild(d);
          exitDinos.push(d);
        }
      }

      // FAR: muchos, pequeños, lejos (sobre las colinas)
      populateLayer("layer-far", {
        count: 9,
        minSize: 30,
        maxSize: 52,
        botMin: 30,
        botMax: 40,
        flyers: true,
        flyerChance: 0.35,
        skyTop: [12, 34],
      });
      // MID: medianos
      populateLayer("layer-mid", {
        count: 6,
        minSize: 52,
        maxSize: 84,
        botMin: 17,
        botMax: 24,
        flyers: true,
        flyerChance: 0.25,
        skyTop: [18, 40],
      });
      // NEAR: pocos, grandes (delante del suelo frontal)
      populateLayer("layer-near", {
        count: 4,
        minSize: 80,
        maxSize: 120,
        botMin: 3,
        botMax: 9,
        flyers: false,
        flyerChance: 0,
        skyTop: [0, 0],
      });

      // pasto disperso
      const grassLayer = document.getElementById("grass-layer");
      for (let i = 0; i < 10; i++) {
        const g = document.createElement("div");
        g.className = "grass";
        g.style.left = rand(2, 96) + "%";
        g.style.bottom = rand(3, 12) + "%";
        const sc = rand(0.5, 1.2);
        g.style.transform = `scale(${sc})`;
        g.style.opacity = rand(0.5, 0.9);
        g.innerHTML = grassSVG(pick(["#3f8a46", "#4f9a52", "#367a3d"]));
        grassLayer.appendChild(g);
      }

      // helechos lejanos
      for (let i = 0; i < 6; i++) {
        const f = document.createElement("div");
        f.className = "fern-far";
        f.style.left = rand(4, 94) + "%";
        f.style.bottom = rand(28, 38) + "%";
        const sc = rand(0.6, 1.1);
        f.style.transform = `scale(${sc})`;
        f.innerHTML = fernSVG("#4a8f54");
        document.getElementById("hills-mid").parentElement.insertBefore(
          f,
          document.getElementById("layer-far")
        );
      }

      // ── estrellas ──
      const starsEl = document.getElementById("stars");
      let starsHTML = "";
      for (let i = 0; i < 110; i++) {
        const sz = Math.random() * 2.4 + 0.8;
        starsHTML +=
          `<span class="star" style="left:${Math.random() * 100}%;` +
          `top:${Math.random() * 62}%;width:${sz}px;height:${sz}px;` +
          `--tw:${(Math.random() * 2 + 2).toFixed(1)}s"></span>`;
      }
      starsEl.innerHTML = starsHTML;

      // ════════════════════════════════════════════════════════════
      //  GSAP ScrollTrigger
      // ════════════════════════════════════════════════════════════
      gsap.registerPlugin(ScrollTrigger);

      const sky = document.getElementById("sky");
      const intro = document.getElementById("intro");

      const SKY = {
        morning: ["#ffe29a", "#ffd28a", "#ffc89e", "#9fd4f0", "#cfeafe"],
        noon: ["#bfe6ff", "#aadcff", "#a6d8ff", "#8fcdf5", "#cdeeff"],
        sunset: ["#ffd27a", "#ff9e6b", "#ff7b86", "#a96bbf", "#6a5acd"],
        dusk: ["#5a4a9c", "#3f3a85", "#33306f", "#23234f", "#1a1a3e"],
        night: ["#10153a", "#0d1030", "#0a0d28", "#070a20", "#050818"],
      };
      function buildGradient(stops) {
        return (
          `linear-gradient(to bottom, ${stops[0]} 0%, ${stops[1]} 28%, ` +
          `${stops[2]} 52%, ${stops[3]} 78%, ${stops[4]} 100%)`
        );
      }
      function hexToRgb(h) {
        const n = parseInt(h.slice(1), 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      const SKY_HEX = [
        { t: 0.0, c: SKY.morning },
        { t: 0.25, c: SKY.noon },
        { t: 0.5, c: SKY.sunset },
        { t: 0.72, c: SKY.dusk },
        { t: 1.0, c: SKY.night },
      ].map((k) => ({ t: k.t, c: k.c.map(hexToRgb) }));
      function lerp(a, b, f) {
        return Math.round(a + (b - a) * f);
      }
      function setSkyByProgress(prog) {
        let a = SKY_HEX[0],
          b = SKY_HEX[SKY_HEX.length - 1];
        for (let i = 0; i < SKY_HEX.length - 1; i++) {
          if (prog >= SKY_HEX[i].t && prog <= SKY_HEX[i + 1].t) {
            a = SKY_HEX[i];
            b = SKY_HEX[i + 1];
            break;
          }
        }
        const span = b.t - a.t || 1;
        const f = gsap.utils.clamp(0, 1, (prog - a.t) / span);
        const stops = a.c.map((ac, j) => {
          const bc = b.c[j];
          return `rgb(${lerp(ac[0], bc[0], f)},${lerp(ac[1], bc[1], f)},${lerp(
            ac[2],
            bc[2],
            f
          )})`;
        });
        sky.style.background = buildGradient(stops);
      }
      setSkyByProgress(0);

      function arc(p) {
        const x = (p - 0.5) * 78;
        const y = 12 + (1 - Math.sin(p * Math.PI)) * 78;
        return { x: x + "vw", y: y + "vh" };
      }
      function placeCelestial(el, p, opacity) {
        const { x, y } = arc(p);
        gsap.set(el, { xPercent: -50, x: x, y: y, opacity: opacity });
      }
      placeCelestial(document.getElementById("sun"), 0.04, 1);
      placeCelestial(document.getElementById("moon"), 0.0, 0);

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-track",
          start: "top top",
          end: "bottom bottom",
          scrub: 0.6,
          onUpdate: (self) => {
            const prog = self.progress;
            setSkyByProgress(prog);
            const sunP = gsap.utils.clamp(0, 1, prog / 0.62);
            const sunOpacity = gsap.utils.clamp(0, 1, (0.7 - prog) / 0.18);
            placeCelestial(
              document.getElementById("sun"),
              0.04 + sunP * 0.96,
              prog < 0.7 ? 1 : sunOpacity
            );
            const moonP = gsap.utils.clamp(0, 0.5, ((prog - 0.6) / 0.4) * 0.5);
            const moonOpacity = gsap.utils.clamp(0, 1, (prog - 0.6) / 0.12);
            placeCelestial(document.getElementById("moon"), moonP, moonOpacity);
          },
        },
      });

      // nubes derivan + se desvanecen
      gsap.utils.toArray(".cloud").forEach((c, i) => {
        const depth = parseFloat(c.dataset.depth) || 0.4;
        tl.to(c, { x: (i % 2 ? 1 : -1) * 120 * depth, duration: 4 }, 0);
        tl.to(c, { opacity: 0, duration: 0.8 }, 2.8);
      });

      // colinas parallax
      tl.to("#hills-back", { yPercent: -6, duration: 4 }, 0);
      tl.to("#hills-mid", { yPercent: -3, duration: 4 }, 0);

      // estrellas
      tl.to("#stars", { opacity: 1, duration: 1.2 }, 2.9);
      // estrella fugaz
      tl.fromTo(
        "#shooting-star",
        { opacity: 0, x: 0, y: 0 },
        { opacity: 1, x: -160, y: 60, duration: 0.5 },
        3.6
      ).to("#shooting-star", { opacity: 0, duration: 0.3 }, 4.1);

      // ── Herd: roaming de día + salida nocturna ──
      exitDinos.forEach((d, i) => {
        const dir = d._exitLeft ? -1 : 1;
        // roaming suave durante el día
        tl.to(
          d,
          { x: dir * rand(4, 14) + "vw", duration: 2.6, ease: "none" },
          0
        );
        // salida al anochecer (escalonada)
        const startT = 2.5 + (i % 6) * 0.06;
        if (d._flyer) {
          tl.to(
            d,
            { x: dir * 140 + "vw", y: "-40vh", opacity: 0, duration: 1.1 },
            startT
          );
        } else {
          tl.to(
            d,
            { x: dir * 140 + "vw", opacity: 0, duration: 1.1 },
            startT
          );
        }
      });

      // ── Protagonistas: se miran y se duermen ──
      // Stego (izq) mira a la derecha → ya mira al bronto.
      // Bronto (der): el sauropod mira a la derecha; lo volteamos para que
      // mire hacia el stego (izquierda).
      gsap.set("#bronto", { scaleX: -1, transformOrigin: "bottom center" });

      // de noche se inclinan suavemente el uno hacia el otro (sin despegarse del suelo)
      tl.to("#stego", { rotation: 4, duration: 0.8 }, 3.3);
      tl.to("#bronto", { rotation: 4, duration: 0.8 }, 3.3);
      // se acercan y se juntan (solapamiento leve)
      tl.to("#main-dinos", { gap: "0px", duration: 0.8 }, 3.3);
      tl.to("#bronto", { marginLeft: "-14px", duration: 0.8 }, 3.3);

      // ojos a dormir: ocultar ojo abierto, mostrar párpado
      tl.to(".eye-open", { opacity: 0, duration: 0.4 }, 3.7);
      tl.to(".sleep-lid", { opacity: 1, duration: 0.4 }, 3.7);

      // corazón de amor
      tl.to(
        "#love-heart",
        { opacity: 1, scale: 1, y: "-8px", duration: 0.8, ease: "back.out(2)" },
        3.6
      );

      // Z de sueño
      tl.to("#zzz1", { opacity: 1, x: "8px", y: "-30px", duration: 1 }, 3.9);
      tl.to("#zzz2", { opacity: 1, x: "24px", y: "-52px", duration: 1 }, 4.1);
      tl.to("#zzz3", { opacity: 1, x: "42px", y: "-74px", duration: 1 }, 4.3);

      // ── Mensajes de la historia durante el día→noche ──
      // Cada uno aparece y desaparece antes del siguiente; el último se va
      // justo antes de que entre el mensaje final.
      const storyMsgs = gsap.utils.toArray(".story-msg");
      const storyBeats = [0.4, 1.4, 2.4, 3.3];
      gsap.set(storyMsgs, { y: 14 });
      storyMsgs.forEach((el, i) => {
        const t = storyBeats[i];
        tl.to(el, { opacity: 1, y: 0, duration: 0.5, ease: "power1.out" }, t);
        tl.to(el, { opacity: 0, y: -10, duration: 0.5, ease: "power1.in" }, t + 0.8);
      });

      // mensaje final
      tl.to("#final", { opacity: 1, y: 0, duration: 1 }, 4.5);
      tl.add(() => {}, 5.2);

      // ── Intro fade ──
      let introGone = false;
      ScrollTrigger.create({
        trigger: "#scroll-track",
        start: "top top",
        end: "+=120",
        onUpdate: (self) => {
          if (!introGone && self.progress > 0.04) {
            introGone = true;
            intro.style.opacity = "0";
            setTimeout(() => (intro.style.display = "none"), 600);
          }
        },
      });

      // ════════════════════════════════════════════════════════════
      //  Corazones voladores (escena final) — repartidos en todo el ancho
      // ════════════════════════════════════════════════════════════
      const heartsBox = document.getElementById("hearts");
      const HEART_CHARS = ["💛", "💖", "💕", "🦕", "💗", "🧡"];
      let heartsStarted = false;
      let heartsTimer = null;

      function spawnHeart() {
        const h = document.createElement("div");
        h.className = "fly-heart";
        h.textContent = HEART_CHARS[(Math.random() * HEART_CHARS.length) | 0];
        const size = 18 + Math.random() * 26;
        h.style.setProperty("--hs", size + "px");
        heartsBox.appendChild(h);
        // posición inicial: repartida en TODO el ancho, desde abajo
        const startX = Math.random() * window.innerWidth;
        const startY = window.innerHeight + 40;
        gsap.fromTo(
          h,
          { x: startX, y: startY, opacity: 0, rotation: -20 + Math.random() * 40 },
          {
            x: startX + (Math.random() - 0.5) * 180,
            y: -120,
            opacity: 1,
            rotation: -40 + Math.random() * 80,
            duration: 4 + Math.random() * 3,
            ease: "power1.out",
            onComplete: () => h.remove(),
          }
        );
        gsap.to(h, { opacity: 0, duration: 1, delay: 3.2 });
      }

      function startHearts() {
        if (heartsStarted) return;
        heartsStarted = true;
        for (let i = 0; i < 10; i++) setTimeout(spawnHeart, i * 110);
        heartsTimer = setInterval(spawnHeart, 360);
      }

      ScrollTrigger.create({
        trigger: "#scroll-track",
        start: "bottom bottom",
        end: "bottom bottom",
        onEnter: () => startHearts(),
        onUpdate: (self) => {
          if (self.progress >= 0.99 && !heartsStarted) startHearts();
        },
      });

      // ── Botón reiniciar ──
      document.getElementById("reset-btn").addEventListener("click", () => {
        window.scrollTo(0, 0);
        location.reload();
      });

      // recalcular posiciones de corazones al cambiar tamaño
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
