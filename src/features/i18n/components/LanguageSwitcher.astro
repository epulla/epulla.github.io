---
import { languages } from "../ui";
import T from "./T.astro";
---

<div id="lang-switcher" class="relative">
  <button
    id="lang-btn"
    type="button"
    aria-expanded="false"
    aria-controls="lang-menu"
    class="flex items-center justify-center size-9 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-200/70 dark:hover:bg-gray-700/70 aria-expanded:bg-gray-200/70 dark:aria-expanded:bg-gray-700/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-razzmatazz-500 transition cursor-pointer"
  >
    <span class="sr-only"><T k="lang.change" /></span>
    <svg
      class="size-5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m5 8 6 6" />
      <path d="m4 14 6-6 2-3" />
      <path d="M2 5h12" />
      <path d="M7 2h1" />
      <path d="m22 22-5-10-5 10" />
      <path d="M14 18h6" />
    </svg>
  </button>
  <ul
    id="lang-menu"
    hidden
    class="absolute right-0 mt-2 min-w-36 p-1.5 flex flex-col gap-0.5 rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800"
  >
    {
      Object.entries(languages).map(([code, label]) => (
        <li>
          <button
            type="button"
            lang={code}
            data-lang-option={code}
            aria-pressed="false"
            class="w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-razzmatazz-500 aria-pressed:font-semibold aria-pressed:text-razzmatazz-600 dark:aria-pressed:text-razzmatazz-400 transition cursor-pointer"
          >
            {label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const root = document.getElementById("lang-switcher")!;
  const btn = document.getElementById("lang-btn")!;
  const menu = document.getElementById("lang-menu")!;
  const options = menu.querySelectorAll<HTMLButtonElement>("[data-lang-option]");

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute("aria-expanded", String(open));
  };

  const syncPressed = () =>
    options.forEach((option) =>
      option.setAttribute(
        "aria-pressed",
        String(option.dataset.langOption === document.documentElement.lang),
      ),
    );

  btn.addEventListener("click", () => setOpen(menu.hidden));

  options.forEach((option) =>
    option.addEventListener("click", () => {
      const lang = option.dataset.langOption!;
      try {
        localStorage.setItem("lang", lang);
      } catch {}
      window.setLang(lang);
      setOpen(false);
      btn.focus();
    }),
  );

  document.addEventListener("click", (event) => {
    if (!menu.hidden && !root.contains(event.target as Node)) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu.hidden) {
      setOpen(false);
      btn.focus();
    }
  });

  document.addEventListener("langchange", syncPressed);
  syncPressed();
</script>
